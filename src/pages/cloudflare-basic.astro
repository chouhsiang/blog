---
import ArchiveTimelinePanel from "@components/ArchiveTimelinePanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { filterArchivePosts } from "@utils/archive-utils";
import { getSortedPostsList } from "../utils/content-utils";

const cloudflarePosts = filterArchivePosts(await getSortedPostsList(), {
	categories: ["Cloudflare 入門"],
});

const description =
	"30 天入門 Cloudflare 系列，從 CDN、DNS、SSL 到 Zero Trust 的完整中文入門指南。";

const intro =
	"以下為 30 天入門 Cloudflare 系列文章，依 Day 1 至 Day 30 排列，適合從零開始認識 Cloudflare 各項功能。";
---

<MainGridLayout title="Cloudflare 入門" description={description}>
	<ArchiveTimelinePanel
		posts={cloudflarePosts}
		showTags={false}
		heading="Cloudflare 入門"
		intro={intro}
		defaultSortOrder="asc"
		client:load
	/>
</MainGridLayout>
