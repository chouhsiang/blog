---
import ArchiveTimelinePanel from "@components/ArchiveTimelinePanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { filterArchivePosts } from "@utils/archive-utils";
import { getSortedPostsList } from "../utils/content-utils";

const cvePosts = filterArchivePosts(await getSortedPostsList(), {
	categories: ["CVE"],
});

const description =
	"周詳 Sean Chou 向 TWCERT/CC 通報並取得 CVE 編號的漏洞公告整理。";
---

<MainGridLayout title="CVE" description={description}>
	<ArchiveTimelinePanel posts={cvePosts} showTags={false} heading="CVE" client:load />
</MainGridLayout>
