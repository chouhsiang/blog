---
import ArchiveTimelinePanel from "@components/ArchiveTimelinePanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { filterArchivePosts } from "@utils/archive-utils";
import { getSortedPostsList } from "../utils/content-utils";

const cloudflarePosts = filterArchivePosts(await getSortedPostsList(), {
	categories: ["Cloudflare"],
});

const description =
	"Cloudflare 系列，含 30 天入門、30 天實戰與進階技巧，從 CDN、DNS、SSL 到 Zero Trust 的完整中文指南。";

const intro =
	"以下為 Cloudflare 系列文章：WARP 與 Zero Trust 實務筆記、電子郵件路由、30 天入門（Day 1–30）、30 天實戰（Day 1–5）與 Enterprise 進階文章，依序排列。";
---

<MainGridLayout title="Cloudflare" description={description}>
	<ArchiveTimelinePanel
		posts={cloudflarePosts}
		showTags={false}
		heading="Cloudflare"
		intro={intro}
		sortBy="title"
		defaultSortOrder="asc"
		client:load
	/>
</MainGridLayout>
