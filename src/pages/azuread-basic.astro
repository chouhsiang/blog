---
import ArchiveTimelinePanel from "@components/ArchiveTimelinePanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { filterArchivePosts } from "@utils/archive-utils";
import { getSortedPostsList } from "../utils/content-utils";

const azureAdPosts = filterArchivePosts(await getSortedPostsList(), {
	categories: ["Azure AD 入門"],
});

const description =
	"簡單入門 Azure AD 系列，從 Azure AD 簡介、網域管理到 OAuth 與 SAML 自建驗證。";

const intro =
	"以下為簡單入門 Azure AD 系列文章，依 #1 至 #8 排列，介紹 Azure Active Directory 的基礎與進階應用。";
---

<MainGridLayout title="Azure AD 入門" description={description}>
	<ArchiveTimelinePanel
		posts={azureAdPosts}
		showTags={false}
		heading="Azure AD 入門"
		intro={intro}
		defaultSortOrder="asc"
		client:load
	/>
</MainGridLayout>
